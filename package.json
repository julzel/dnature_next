{
  "name": "dnature-next-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium",
    "test:seo": "playwright test --project=seo",
    "test:seo:preview": "playwright test --config=playwright.preview.config.ts",
    "test:regression": "playwright test tests/regression",
    "test:regression:update": "playwright test tests/regression --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  }
}
