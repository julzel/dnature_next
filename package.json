{
  "name": "dnature-next-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run catalog:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:integrations": "node --conditions=react-server --import tsx scripts/check-integrations.ts",
    "catalog:generate": "node --import tsx features/catalog/scripts/generate-product-reference.ts",
    "catalog:check": "node --import tsx features/catalog/scripts/generate-product-reference.ts --check",
    "test:services": "node --conditions=react-server --import tsx --test lib/server/tests/*.test.ts features/*/tests/server/*.test.ts",
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium",
    "test:seo": "playwright test --project=seo",
    "test:seo:preview": "playwright test --config=playwright.preview.config.ts",
    "test:regression": "playwright test tests/regression",
    "test:regression:update": "playwright test tests/regression --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@next/env": "^16.4.5",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
