{
  "name": "dnature",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "supabase:start": "SUPABASE_TELEMETRY_DISABLED=1 supabase start",
    "supabase:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop",
    "supabase:reset": "SUPABASE_TELEMETRY_DISABLED=1 supabase db reset",
    "supabase:lint": "SUPABASE_TELEMETRY_DISABLED=1 supabase db lint --level warning",
    "supabase:test": "SUPABASE_TELEMETRY_DISABLED=1 supabase test db",
    "audit:public-assets": "node scripts/audit-public-assets.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "contentful:mapping:generate": "vite-node scripts/generate-avify-sku-mapping.mjs",
    "contentful:mapping:validate": "node scripts/validate-avify-sku-mapping.mjs",
    "dev:e2e": "E2E_USE_FIXTURES=1 E2E_DIST_DIR=.next-e2e next dev --webpack --hostname 127.0.0.1 --port 3100",
    "baseline:performance": "node scripts/capture-performance-baseline.mjs",
    "review:performance": "BASELINE_OUTPUT=performance-current.json node scripts/capture-performance-baseline.mjs && node scripts/compare-performance-baselines.mjs",
    "verify:router-baseline": "node scripts/verify-router-baseline.mjs",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "engines": {
    "node": ">=20.9 <25"
  },
  "dependencies": {
    "@emotion/react": "11.11.4",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource/corinthia": "^5.3.0",
    "@fontsource/roboto": "^5.0.5",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "3.4.0",
    "@googlemaps/js-api-loader": "2.1.1",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.14.0",
    "@mui/material-nextjs": "9.1.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.25.0",
    "next": "16.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-slick": "^0.30.2",
    "sass": "^1.49.0",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/env": "16.3.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "contentful-cli": "^4.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "^26.1.0",
    "supabase": "^2.113.0",
    "vitest": "^3.2.4"
  }
}
