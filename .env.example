# Server-only Contentful credentials
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_API_KEY=
# Optional. Defaults to master; set to staging for safe migration verification.
CONTENTFUL_ENVIRONMENT_ID=master
# Migration-only secret. Never expose it with a NEXT_PUBLIC_ prefix.
CONTENTFUL_MANAGEMENT_TOKEN=

# Server-only Avify integration
AVIFY_API_KEY=
# Optional override for the Avify GraphQL endpoint.
AVIFY_GRAPHQL_URL=https://api.avify.com/graphql
# Optional positive Avify store-location ID for location-specific inventory.
AVIFY_LOCATION_ID=

# Public runtime configuration
NEXT_PUBLIC_SITE_URL=https://dnaturefood.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Public Supabase values. Obtain both from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Product gates. Enable only after the corresponding owner approval.
# Keep invitation during the staff/invited pilot. Public registration also
# requires enabling new signups in the hosted Supabase Auth settings.
ACCOUNT_REGISTRATION_MODE=invitation
ACCOUNT_PORTION_PLANNING_ENABLED=false
ACCOUNT_STAGE_2_ENABLED=false

# Server-only monitoring integration
MONITORING_INGEST_URL=
MONITORING_INGEST_TOKEN=
