# Public canonical origin. Never use a preview deployment URL here.
SITE_URL=https://dnaturefood.com

# Enable only on the reviewed production deployment, then rebuild.
# Vercel preview/development and Netlify non-production contexts stay noindex.
SEO_INDEXING_ENABLED=false

# Optional verification tokens (not analytics IDs).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Explicit brand decision: inherit | allow | disallow.
# Inherit adds no GPTBot-specific rule; training follows the general crawl policy.
GPTBOT_POLICY=inherit
