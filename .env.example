# Additional development hostnames, comma-separated, without scheme or port.
# Example: 192.168.100.13,my-device.local
ALLOWED_DEV_ORIGINS=

# Public canonical origin. Never use a preview deployment URL here.
SITE_URL=https://dnaturefood.com

# Enable only on the reviewed production deployment, then rebuild.
# Vercel preview/development and Netlify non-production contexts stay noindex.
SEO_INDEXING_ENABLED=false

# Optional verification tokens (not analytics IDs).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Explicit brand decision: inherit | allow | disallow.
# Inherit adds no GPTBot-specific rule; training follows the general crawl policy.
GPTBOT_POLICY=inherit

# Optional public browser key for the Contacto map (Maps Embed API).
# Restrict to allowed website referrers and the Maps Embed API.
# Without it, the location remains available through a Google Maps link.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend integrations: server-only. Never prefix these with NEXT_PUBLIC_.
# Use the endpoint supplied by Avify for your store; never silently switch to a sandbox.
AVIFY_GRAPHQL_URL=https://api.avify.com/graphql
AVIFY_API_KEY=
# Optional positive integer. Blank requests global inventory.
AVIFY_LOCATION_ID=

# Published content only (Content Delivery API). No management token is needed.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT_ID=master
CONTENTFUL_DELIVERY_API_KEY=
CONTENTFUL_LOCALE=es-CR
